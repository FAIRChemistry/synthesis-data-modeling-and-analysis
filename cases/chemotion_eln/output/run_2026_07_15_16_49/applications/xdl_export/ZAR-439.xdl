        <Add vessel="5 mL vial" reagent="toluene" amount="3000 microlitre" dropwise="false" comment="Take it out of the glovebox. Add toluene 3000 µL [should be adjusted according to the AgOTf amount] → colorless solution" />
        <Add vessel="50 mL flask" reagent="Co(ttpp)" dropwise="false" comment="Reaction: Add Co(ttpp)" />
        <Add vessel="50 mL flask" reagent="pyridine" dropwise="false" comment="Add pyridine" />
        <Add vessel="50 mL flask" reagent="toluene" amount="26 millilitre" dropwise="false" comment="Add toluene 26 mL" />
        <Sonicate vessel="50 mL flask" time="3 minute" comment="Sonicate for 3 min → Dark red solution" />
        <Add vessel="50 mL flask" reagent="AgOTf" dropwise="true" comment="Cover with aluminum foil. Start stirring at 400 rpm. Add 1500 µL of AgOTf/toluene dropwise with a mechanical pipette [syringe should be used]" />
