      </Prep>
      <Reaction>
        <Wait vessel="50 mL flask" time="2 hour" comment="Continue stirring for 2 h → Dark green mixture [1 h is enough]" />
      </Reaction>
      <Workup>
        <Evaporate vessel="50 mL flask" method="rotary_evaporator" temp="40 celsius" comment="Ag scavenging: Remove volatiles with rotovap (40 °C)" />
        <Add vessel="50 mL flask" reagent="DCM" amount="25 millilitre" dropwise="false" comment="Add 25 mL of DCM" />
        <Sonicate vessel="50 mL flask" comment="Swirl and sonicate → Dark green mixture" />
        <Add vessel="50 mL flask" reagent="3-mercaptopropyl silica" dropwise="false" comment="Add ISOLUTE Si-Thiol" />
        <Wait vessel="50 mL flask" time="1 hour" comment="Stir at 500 rpm for 1 h" />
        <Filter vessel="? mL RBF" rinse="DCM (50 millilitre)" comment="? mL RBF, suction adapter, glass funnel, filter paper (90 mm?, 15A?), diaphragm pump suction; Filter the mixture → Dark green filtrate; Rinse with DCM 50 mL → Pale green filtrate and xxx residue at the end" />
        <Add vessel="? mL RBF" reagent="n-hexane" amount="300 millilitre" dropwise="false" comment="Reprecipitation: Add n-hexane (300 mL)" />
        <HeatChill vessel="? mL RBF" temp="0 celsius" time="0.5 day" comment="Refrigerate at 0 °C o/n" />
        <Filter vessel="Filter" comment="Filter the mixture → Light yellow filtrate; Rinse with DCM [mistake!]; Reprecipitation again: procedure?; Rinse with 2 x (DCM 15 mL + n-hexane 100 mL); Rinse w/ n-hexane 4 x 20 mL" rinse="DCM + n-hexane; n-hexane" product_portion="residue" />
        <Dry vessel="Filter" time="10 minute" comment="Dry w/ suction for 10 min" />
        <Dry vessel="Filter" time="5 hour" comment="Dry under vacuum (diaphragm pump) for 5 h" />
