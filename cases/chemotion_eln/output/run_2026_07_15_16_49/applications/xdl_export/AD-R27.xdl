    <Procedure>
      <Prep>
        <Add vessel="5 mL vial" reagent="AgOTf" amount="128.72 milligram" dropwise="false" comment="RT 21.1  °C RH   52%. Stock solution preparation: 5 mL vial; Put into the glovebox (H₂O &lt; 1 ppm). Weigh in AgOTf → 128.72 mg" />
        <Add vessel="5 mL vial" reagent="toluene" amount="3000 microlitre" dropwise="false" comment="Take it out of the glovebox. Add 3000 µL of toluene → colorless solution." />
      </Prep>
      <Reaction>
        <Add vessel="50 mL flask" reagent="Co(ttpp)" dropwise="false" comment="Reaction: 50 mL flask; Add Co(ttpp)" />
        <Add vessel="50 mL flask" reagent="pyridine" dropwise="false" comment="Add pyridine" />
        <Add vessel="50 mL flask" reagent="toluene" amount="26 millilitre" dropwise="false" comment="Add toluene 26 mL" />
        <Sonicate vessel="50 mL flask" time="3 minute" comment="Sonicate for 3 min → Dark red solution" />
        <Add vessel="50 mL flask" reagent="AgOTf" dropwise="true" comment="Cover with aluminum foil. Start stirring at 400 rpm. Add 1500 µL of AgOTf/toluene dropwise w/ mechanical pipette (750 x 2)" />
        <Add vessel="50 mL flask" reagent="toluene" amount="1500 microlitre" dropwise="true" comment="Add 1500 µL of AgOTf/toluene dropwise w/ mechanical pipette (750 x 2)" />
        <Wait vessel="50 mL flask" time="1 hour" comment="Continue stirring for 1 h → Dark green mixture" />
      </Reaction>
      <Workup>
        <Evaporate vessel="50 mL flask" method="rotary_evaporator" temp="40 celsius" comment="Ag scavenging: Remove volatiles with a rotovap (40 °C) for 1 h." />
        <Dry vessel="50 mL flask" time="1 hour" comment="Dry under vacuum 1h" />
        <Add vessel="50 mL flask" reagent="dichloromethane" amount="25 millilitre" dropwise="false" comment="Add DCM 25 mL" />
        <Sonicate vessel="50 mL flask" comment="Swirl and sonicate → Dark green mixture" />
        <Add vessel="50 mL flask" reagent="3-mercaptopropyl silica" dropwise="false" comment="Add ISOLUTE Si-Thiol" />
        <Wait vessel="50 mL flask" time="2 hour" comment="Stir at 500 rpm for 2 h" />
        <Filter vessel="250 mL RBF" rinse="dichloromethane (50 millilitre)" comment="20 mL plastic syringe, cotton plug, syringe filter (⌀ 25 mm, 0.45 µm, PTFE), syringe filter (0.2 µm, ⌀ 15 mm, PTFE), 250 mL RBF [difficult to press]. Better to use a frit. or a filter paper.; Filter the mixture → Dark green filtrate collected; Transfer and rinse with DCM 50 mL → pale green filtrate at the end." />
        <Evaporate vessel="250 mL RBF" comment="Evaporate the whole solvent." />
        <Add vessel="250 mL RBF" reagent="dichloromethane" amount="50 millilitre" dropwise="false" comment="Reprecipitation: Add 50 mL of DCM." />
        <Add vessel="250 mL RBF" reagent="n-hexane" amount="300 millilitre" dropwise="false" comment="Add n-hexane (300 mL)." />
        <Sonicate vessel="250 mL RBF" comment="Swirl and sonicate" />
        <HeatChill vessel="250 mL RBF" temp="0 celsius" time="0.5 day" comment="Refrigerate at 0 °C o/n" />
        <Filter vessel="Frit (por. 4)" rinse="DCM + n-hexane; n-hexane" comment="Frit (por. 4); Filter the mixture → light yellow filtrate; Transfer and rinse with 2 x (DCM 15 mL + n-hexane 100 mL); Rinse w/ hexane 4 x 20 mL" />
        <Dry vessel="Frit (por. 4)" time="10 minute" comment="Dry w/ suction for 10 min" />
        <Dry vessel="Frit (por. 4)" time="0.5 day" comment="Dry under vacuum o/n" />
      </Workup>
    </Procedure>
