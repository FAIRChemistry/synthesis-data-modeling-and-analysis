        <Add vessel="10 mL flask" amount="5 millilitre" dropwise="false" reagent="toluene" comment="Add toluene 5 mL" />
        <Sonicate vessel="10 mL flask" time="3 minute" comment="Sonicate for 3 min → Dark green solution" />
        <Add vessel="10 mL flask" reagent="AgOTf" dropwise="true" comment="Cover with aluminum foil. Start stirring at 400 rpm. Add 500 µL of AgOTf/toluene dropwise with a mechanical pipette [syringe should be used]" />
