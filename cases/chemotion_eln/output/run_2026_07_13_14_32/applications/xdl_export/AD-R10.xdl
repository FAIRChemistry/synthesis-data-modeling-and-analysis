<XDL>
  <Synthesis>
    <Hardware>
      <Component id="50 mL two-neck RBF" type="50 mL two-neck RBF" />
      <Component id="15 mL membrane filter holder" type="15 mL membrane filter holder" />
      <Component id="250 mL RBF" type="250 mL RBF" />
      <Component id="Fritted funnel (por.4)" type="Fritted funnel (por.4)" />
      <Component id="Glass Funnel" type="Glass Funnel" />
      <Component id="Filter" type="Filter" />
    </Hardware>
    <Metadata description="AD-R10 - Synthesis of Co(ttpp) (CHCl3/hexane reprecipitation)" product="Co(ttpp)" product_yield_percent="75.9585" />
    <Procedure>
      <Prep>
        <HeatChill vessel="50 mL two-neck RBF" temp="120 celsius" comment="Heat a 50 mL two-neck RBF in an oven (120°C) for &gt;1.5 h." />
        <EvacuateAndRefill vessel="50 mL two-neck RBF" pressure="0.089 mbar" gas="N2" comment="Assemble and fix a reflux condenser, a T-shaped connector, and a bubbler (filled with paraffin oil) at a Schlenk line; Remove the RBF and quickly assemble it with a stir bar, rubber septum, and reflux condenser while it is still hot. Evacuate (0.089 mbar) and heat the bottom part of the reflux condenser and flask with a heat gun (250°C). Backfill with N₂." />
        <Add vessel="50 mL two-neck RBF" reagent="TAPP" amount="0.25042 gram" dropwise="false" comment="Add TAPP and TrBr (plastic spatula) quickly" />
        <Add vessel="50 mL two-neck RBF" reagent="TrBr" amount="0.5987 gram" dropwise="false" comment="Add TAPP and TrBr (plastic spatula) quickly" />
        <EvacuateAndRefill vessel="50 mL two-neck RBF" gas="N2" comment="Cycle with N₂ slowly x3" />
        <Add vessel="50 mL two-neck RBF" reagent="Et3N" amount="0.3749 gram" dropwise="false" comment="Add Et3N" />
        <Add vessel="50 mL two-neck RBF" reagent="THF" amount="20 millilitre" dropwise="false" comment="Add the THF syringe. [10:57] ( Dark Green )" />
        <Sonicate vessel="50 mL two-neck RBF" comment="→ 0.1 mL + CDCl₃ 500 µL, sonicate → ¹H NMR M1 [11:08]" />
        <Add vessel="50 mL two-neck RBF" reagent="CoCl2" amount="0.2886 gram" dropwise="false" comment="Stop stirring. Close the N₂ connection. Add CoCl₂ quickly. Close. Resume stirring." />
        <EvacuateAndRefill vessel="50 mL two-neck RBF" gas="N2" time="10 second" comment="Purge with N₂ for 10 s" />
      </Prep>
      <Reaction>
        <EvacuateAndRefill vessel="50 mL two-neck RBF" gas="N2" time="30 minute" comment="Bubble with N₂, 30 min." />
        <HeatChill vessel="50 mL two-neck RBF" temp="85 celsius" reflux="true" time="15 minute" comment="Heat to reflux (85 °C, 1.25 atm) for ca. 15 min (Dark green brown colour)" />
        <Wait vessel="50 mL two-neck RBF" time="2 hour" comment="Heat for 2 h (16:37). Cool down to RT." />
      </Reaction>
      <Workup>
        <Add vessel="15 mL membrane filter holder" reagent="neutral alumina" amount="12.5 millilitre" dropwise="false" comment="[ 12.01, RT 22.1 °C and RH 30 %]; Add 12.5 mL of neutral alumina in a 15 mL membrane filter holder (frit). Attach the funnel to a vacuum and a 250 mL RBF." />
        <Add vessel="250 mL RBF" reagent="THF" dropwise="false" comment="Wet the alumina with THF; Load the reaction mixture; Elute with THF and full power suction with occasional digging of the top layer. (Eluate became red at the end). Eluent was kept in the fridge o/n." />
        <Evaporate vessel="250 mL RBF" method="rotary_evaporator" comment="Rotovap" />
        <Dry vessel="250 mL RBF" time="1 hour" comment="Dry under vacuum, 1 h" />
        <Add vessel="250 mL RBF" reagent="CHCl3" amount="50 millilitre" dropwise="false" comment="CHCl3 deacidification: 250 mL RBF; Basic Al2O3 --&gt; 50 mL; CHCl3 50 mL (mix in flask ---&gt; then filter)" />
        <Filter vessel="Fritted funnel (por.4)" comment="Fritted funnel (por.4), suction adapter, 250 mL RBF; Filtered" />
        <Add vessel="250 mL RBF" reagent="CHCl3" amount="25 millilitre" dropwise="false" comment="Reprecipitation: Purified CHCl3 25 mL, sonicate (dark red solution)" />
        <Sonicate vessel="250 mL RBF" comment="→ 0.1 mL + DMSO-d6 500 µL → ¹H NMR M5 [09:17]; sonicate" />
        <Add vessel="250 mL RBF" reagent="n-hexane" amount="140 millilitre" dropwise="false" comment="n-hexane 140 mL, manually stir, sonicate" />
        <Wait vessel="250 mL RBF" time="30 minute" comment="Fridge, 30 min" />
        <Filter vessel="Glass Funnel" rinse="purified CHCl3 + n-hexane; n-hexane" comment="Glass Funnel, Filter paper (big, 15A), suction adapter, 250 mL RBF; Filter w/ suction; Transfer &amp; rinse w/ 2 x (purified CHCl3 3 mL + 10 mL hex); Rinse w/ hex x2 (2x 15 mL)" />
        <Dry vessel="Filter" time="0.5 day" comment="Dry under vacuum o/n; 20 mL vial, PTFE sealing (tare w/ lid: 8.94046g); → 479 mg product" />
      </Workup>
    </Procedure>
    <Reagents>
      <Reagent id="TAPP" name="TAPP" role="reagent" />
      <Reagent id="TrBr" name="TrBr" role="reagent" />
      <Reagent id="CoCl2" name="CoCl2" role="reagent" />
      <Reagent id="Et3N" name="Et3N" role="reagent" />
      <Reagent id="THF" name="THF" role="reagent" />
    </Reagents>
  </Synthesis>
</XDL>
