<XDL>
  <Synthesis>
    <Hardware>
      <Component id="5 mL vial" type="5 mL vial" />
      <Component id="50 mL flask" type="50 mL flask" />
      <Component id="? mL RBF" type="? mL RBF" />
      <Component id="Filter" type="Filter" />
    </Hardware>
    <Metadata description="ZAR-439 - Synthesis of [Co(ttpp)(py)2](OTf)" product="[Co(ttpp)(py)2](OTf)" product_yield_percent="71" />
    <Procedure>
      <Prep>
        <Add vessel="5 mL vial" reagent="AgOTf" amount="128.2 milligram" dropwise="false" comment="Stock solution preparation: 5 mL vial. Put into the glovebox (H₂O &lt; 1 ppm). Weigh in AgOTf → 128.2 mg" />
        <Add vessel="5 mL vial" reagent="toluene" amount="3000 microlitre" dropwise="false" comment="Take it out of the glovebox. Add toluene 3000 µL [should be adjusted according to the AgOTf amount] → colorless solution." />
        <Add vessel="50 mL flask" reagent="Co(ttpp)" dropwise="false" comment="Reaction: Add Co(ttpp)" />
        <Add vessel="50 mL flask" reagent="pyridine" dropwise="false" comment="Add pyridine" />
        <Add vessel="50 mL flask" reagent="toluene" amount="26 millilitre" dropwise="false" comment="Add toluene 26 mL" />
        <Sonicate vessel="50 mL flask" time="3 minute" comment="Sonicate for 3 min → Dark red solution" />
        <Add vessel="50 mL flask" reagent="AgOTf" dropwise="true" comment="Add 1500 µL of AgOTf/toluene dropwise with a mechanical pipette [syringe should be used]" />
        <Add vessel="50 mL flask" reagent="toluene" amount="1500 microlitre" dropwise="true" comment="Add 1500 µL of AgOTf/toluene dropwise with a mechanical pipette [syringe should be used]" />
      </Prep>
      <Reaction>
        <Wait vessel="50 mL flask" time="2 hour" comment="Continue stirring for 2 h → Dark green mixture [1 h is enough]" />
      </Reaction>
      <Workup>
        <Evaporate vessel="50 mL flask" method="rotary_evaporator" temp="40 celsius" comment="Ag scavenging: Remove volatiles with rotovap (40 °C)" />
        <Add vessel="50 mL flask" reagent="DCM" amount="25 millilitre" dropwise="false" comment="Add 25 mL of DCM" />
        <Sonicate vessel="50 mL flask" comment="Swirl and sonicate → Dark green mixture" />
        <Add vessel="50 mL flask" reagent="3-mercaptopropyl silica" dropwise="false" comment="Add ISOLUTE Si-Thiol" />
        <Wait vessel="50 mL flask" time="1 hour" comment="Stir at 500 rpm for 1 h" />
        <Filter vessel="? mL RBF" rinse="DCM (50 millilitre)" comment="? mL RBF, suction adapter, glass funnel, filter paper (90 mm?, 15A?), diaphragm pump suction; Filter the mixture → Dark green filtrate; Rinse with DCM 50 mL → Pale green filtrate and xxx residue at the end" />
        <Add vessel="? mL RBF" reagent="n-hexane" amount="300 millilitre" dropwise="false" comment="Reprecipitation: Add n-hexane (300 mL)" />
        <HeatChill vessel="? mL RBF" temp="0 celsius" time="0.5 day" comment="Refrigerate at 0 °C o/n" />
        <Filter vessel="Filter" product_portion="residue" rinse="DCM + n-hexane; n-hexane" comment="Filter the mixture → Light yellow filtrate; Rinse with 2 x (DCM 15 mL + n-hexane 100 mL); Rinse w/ n-hexane 4 x 20 mL" />
        <Dry vessel="Filter" time="10 minute" comment="Dry w/ suction for 10 min" />
        <Dry vessel="Filter" time="5 hour" comment="Dry under vacuum (diaphragm pump) for 5 h" />
      </Workup>
    </Procedure>
    <Reagents>
      <Reagent id="Co(ttpp)" name="Co(ttpp)" role="reagent" />
      <Reagent id="AgOTf" name="AgOTf" role="reagent" />
      <Reagent id="pyridine" name="pyridine" role="reagent" />
      <Reagent id="toluene" name="toluene" role="reagent" />
      <Reagent id="3-mercaptopropyl silica" name="3-mercaptopropyl silica" role="reagent" />
    </Reagents>
  </Synthesis>
</XDL>
