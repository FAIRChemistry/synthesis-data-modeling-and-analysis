<XDL>
  <Synthesis>
    <Hardware>
      <Component id="reactor" type="reactor" />
    </Hardware>
    <Metadata description="WAT-Ch-045 - L-Ile oNs-Schützung" product="sauber" product_yield_percent="50.0028" />
    <Procedure>
      <Prep>
        <EvacuateAndRefill vessel="reactor" gas="N2" />
        <Add vessel="reactor" reagent="DCM  " amount="160 millilitre" />
        <Add vessel="reactor" reagent="L-Ile-Me HCl 044" amount="20 gram" comment="Aminosäureester unter Schutzgas in DCM lösen" />
        <HeatChill vessel="reactor" temp="0 celsius" comment="auf 0 °C kühlen" />
      </Prep>
      <Reaction>
        <Add vessel="reactor" reagent="DCM (NsCl)" amount="50 millilitre" />
        <Add vessel="reactor" reagent="2-NsCl" amount="26.7161 gram" dropwise="true" />
        <Add vessel="reactor" reagent="Triethylamin" amount="32.1347 millilitre" dropwise="true" />
        <HeatChill vessel="reactor" temp="25 celsius" />
        <Wait vessel="reactor" time="18 hour" comment="für 18 h bei RT rühren" />
      </Reaction>
      <Workup>
        <Extract vessel="reactor" solvent="DCM" repeat="1" phase_kept="organic" comment="wässrige Phase extrahieren mit 1x DCM" />
        <WashPhase vessel="reactor" solution="Wasser" phase="organic" repeat="3" />
        <Dry vessel="reactor" desiccant="MgSO4" />
        <Evaporate vessel="reactor" comment="LM entfernen" />
        <Purify vessel="reactor" eluent="Pe/EtOAc 5:1 -&gt; 3:1" />
      </Workup>
    </Procedure>
    <Reagents>
      <Reagent id="L-Ile-Me HCl 044" name="L-Ile-Me HCl 044" role="substrate" />
      <Reagent id="2-NsCl" name="2-NsCl" role="reagent" />
      <Reagent id="Triethylamin" name="Triethylamin" role="reagent" />
      <Reagent id="DCM (NsCl)" name="DCM (NsCl)" role="solvent" />
      <Reagent id="DCM  " name="DCM  " role="solvent" />
    </Reagents>
  </Synthesis>
</XDL>
