<XDL>
  <Synthesis>
    <Hardware>
      <Component id="reactor" type="reactor" />
    </Hardware>
    <Metadata description="WAT-Ch-081 - Reduktion Aminoester Ile zu Alkohol ohne Aufarbeitung" product="ausgewogen" />
    <Procedure>
      <Prep>
        <EvacuateAndRefill vessel="reactor" gas="N2" />
        <Add vessel="reactor" reagent="THF" amount="85 millilitre" />
        <Add vessel="reactor" reagent="Aminoester 080" amount="4.711 gram" comment="Aminoester unter N2 in THF lösen" />
        <HeatChill vessel="reactor" temp="0 celsius" comment="kühlen auf 0 °C; Dauer nicht angegeben" />
      </Prep>
      <Reaction>
        <Add vessel="reactor" reagent="THF (LAH)" amount="15 millilitre" />
        <Add vessel="reactor" reagent="LAH (fest)" amount="0.44043 gram" dropwise="true" />
        <HeatChill vessel="reactor" temp="0 celsius" time="30 minute" comment="Rühren für 30 min @0 °C" />
        <Add vessel="reactor" reagent="Wasser" comment="quenchen mit Wasser; Menge nicht angegeben" />
      </Reaction>
      <Workup>
        <Add vessel="reactor" reagent="DCM" comment="Zugabe von DCM; Phasen trennen" />
        <Extract vessel="reactor" solvent="DCM" phase_kept="organic" comment="Phasentrennung nach Zugabe von DCM" />
        <WashPhase vessel="reactor" solution="HCl 1M" phase="organic" repeat="1" comment="gleiche Menge wie THF" />
        <WashPhase vessel="reactor" solution="brine" phase="organic" repeat="2" />
        <Dry vessel="reactor" desiccant="MgSO4" comment="Trocknen über MgSO4" />
        <Evaporate vessel="reactor" method="rotary_evaporator" comment="LM am Roti entfernen" />
        <Purify vessel="reactor" eluent="Pe/EtOAc 4:1 -&gt; 3:1 -&gt; 1:1" comment="Säule (Pe/EtOAc 4:1 -&gt; 3:1 -&gt; 1:1)" />
      </Workup>
    </Procedure>
    <Reagents>
      <Reagent id="Aminoester 080" name="Aminoester 080" role="substrate" />
      <Reagent id="LAH (fest)" name="LAH (fest)" role="reagent" />
      <Reagent id="THF" name="THF" role="solvent" />
      <Reagent id="THF (LAH)" name="THF (LAH)" role="solvent" />
    </Reagents>
  </Synthesis>
</XDL>
