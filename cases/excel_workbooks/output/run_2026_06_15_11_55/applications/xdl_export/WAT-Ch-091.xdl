<XDL>
  <Synthesis>
    <Hardware>
      <Component id="reactor" type="reactor" />
    </Hardware>
    <Metadata description="WAT-Ch-091 - Cyclisierung Ile FeCl3 crude Aldehyd" product="Olefin rein" product_yield_percent="37.3545" />
    <Procedure>
      <Prep>
        <EvacuateAndRefill vessel="reactor" gas="N2" comment="unter N2" />
        <Add vessel="reactor" reagent="DCM (Aldehyd)" amount="100 millilitre" />
        <Add vessel="reactor" reagent="Aminoaldehyd 090" amount="5.67 gram" comment="Aminoaldehyd in DCM lösen" />
        <HeatChill vessel="reactor" temp="0 celsius" />
      </Prep>
      <Reaction>
        <Add vessel="reactor" reagent="DEE (FeCl3)" amount="22 millilitre" />
        <Add vessel="reactor" reagent="FeCl3 (Schlenk)" amount="4.8093 gram" dropwise="true" comment="langsame Zugabe von FeCl3-Lsg (1 M in DEE)" />
        <HeatChill vessel="reactor" temp="25 celsius" comment="Reaktion ü.N. bei RT gerührt" />
      </Reaction>
      <Workup>
        <Add vessel="reactor" reagent="2M NaOH" comment="neutralisiert mit 2M NaOH; Menge nicht angegeben" />
        <Extract vessel="reactor" solvent="DCM" phase_kept="organic" />
        <Dry vessel="reactor" desiccant="MgSO4" comment="über MgSO4 trocknen" />
        <Evaporate vessel="reactor" method="rotary_evaporator" comment="Das Lösungsmittel wird am Roti entfernt" />
        <Purify vessel="reactor" eluent="Pe/EtOAc 2:1 -&gt; 1:1 -&gt; 1:2" />
      </Workup>
    </Procedure>
    <Reagents>
      <Reagent id="Aminoaldehyd 090" name="Aminoaldehyd 090" role="substrate" />
      <Reagent id="FeCl3 (Schlenk)" name="FeCl3 (Schlenk)" role="catalyst" />
      <Reagent id="DCM (Aldehyd)" name="DCM (Aldehyd)" role="solvent" />
      <Reagent id="DEE (FeCl3)" name="DEE (FeCl3)" role="solvent" />
    </Reagents>
  </Synthesis>
</XDL>
