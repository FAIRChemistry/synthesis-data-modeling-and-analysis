<XDL>
  <Synthesis>
    <Hardware>
      <Component id="reactor" type="reactor" />
    </Hardware>
    <Metadata description="WAT-Ch-065 - Aminierung geschütztes Ile mit Bromolefin" product="tert. Amin" product_yield_percent="46.4429" />
    <Procedure>
      <Prep>
        <EvacuateAndRefill vessel="reactor" gas="N2" />
        <Add vessel="reactor" reagent="DMF" amount="30 millilitre" />
        <Add vessel="reactor" reagent="Ns-Ile-OMe 063" amount="1.871 gram" comment="Aminoester in DMF lösen" />
      </Prep>
      <Reaction>
        <Add vessel="reactor" reagent="Cs2CO3" amount="3.69058 gram" />
        <Add vessel="reactor" reagent="Bromolefin 021" amount="1.64292 gram" />
        <HeatChill vessel="reactor" temp="60 celsius" comment="rühren ü.N." />
      </Reaction>
      <Workup>
        <HeatChill vessel="reactor" temp="25 celsius" comment="Auf RT abkühlen" />
        <Add vessel="reactor" reagent="DEE" comment="mit DEE versetzen; Menge nicht angegeben" />
        <WashPhase vessel="reactor" solution="Wasser" phase="organic" repeat="2" />
        <WashPhase vessel="reactor" solution="brine" phase="organic" repeat="2" />
        <Dry vessel="reactor" desiccant="MgSO4" />
        <Evaporate vessel="reactor" method="rotary_evaporator" comment="LM am Roti entfernen" />
        <Purify vessel="reactor" eluent="Pe/EtOAc 3:1 -&gt; 2:1" comment="Rohprodukt über Säule (Pe/EtOAc 3:1 -&gt; 2:1) reinigen" />
      </Workup>
    </Procedure>
    <Reagents>
      <Reagent id="Ns-Ile-OMe 063" name="Ns-Ile-OMe 063" role="substrate" />
      <Reagent id="Bromolefin 021" name="Bromolefin 021" role="reagent" />
      <Reagent id="Cs2CO3" name="Cs2CO3" role="reagent" />
      <Reagent id="DMF" name="DMF" role="solvent" />
    </Reagents>
  </Synthesis>
</XDL>
