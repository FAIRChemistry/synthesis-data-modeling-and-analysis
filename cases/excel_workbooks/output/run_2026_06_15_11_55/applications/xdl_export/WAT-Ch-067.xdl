<XDL>
  <Synthesis>
    <Hardware>
      <Component id="reactor" type="reactor" />
    </Hardware>
    <Metadata description="WAT-Ch-067 - DMP-Oxidation Aminoalkohol zu Aminoaldehyd Ile" product="Aminoaldehyd" product_yield_percent="99.5589" />
    <Procedure>
      <Prep>
        <Add vessel="reactor" reagent="DCM" amount="4 millilitre" />
        <Add vessel="reactor" reagent="Alkohol 066" amount="0.104 gram" comment="Aminoalkohol in DCM lösen" />
      </Prep>
      <Reaction>
        <Add vessel="reactor" reagent="DMP" amount="0.286812 gram" />
        <HeatChill vessel="reactor" temp="25 celsius" />
        <Wait vessel="reactor" time="40 minute" comment="Rühren bei RT für 40 min" />
      </Reaction>
      <Workup>
        <Add vessel="reactor" reagent="DEE" amount="5 millilitre" comment="Zugabe von DEE (5 mL)" />
        <Add vessel="reactor" reagent="Na2S2O3-/NaHCO3-Lsg" amount="5 millilitre" comment="5 mL, 1:1" />
        <Wait vessel="reactor" time="15 minute" comment="rühren für weitere 15 min bis klare Lösung erhalten wird" />
        <Extract vessel="reactor" solvent="DEE" phase_kept="organic" />
        <WashPhase vessel="reactor" solution="NaHCO3-Lsg" phase="organic" repeat="2" />
        <WashPhase vessel="reactor" solution="Wasser" phase="organic" repeat="2" />
        <WashPhase vessel="reactor" solution="brine" phase="organic" repeat="2" />
        <Dry vessel="reactor" desiccant="MgSO4" comment="Trocknen über MgSO4" />
        <Evaporate vessel="reactor" method="rotary_evaporator" comment="LM an Roti entfernen" />
        <Purify vessel="reactor" eluent="Pe/EtOAc 4:1 -&gt; 2:1" />
      </Workup>
    </Procedure>
    <Reagents>
      <Reagent id="Alkohol 066" name="Alkohol 066" role="substrate" />
      <Reagent id="DMP" name="DMP" role="reagent" />
      <Reagent id="DCM" name="DCM" role="solvent" />
    </Reagents>
  </Synthesis>
</XDL>
